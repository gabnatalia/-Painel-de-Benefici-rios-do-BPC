# ==============================================================================
# PAINEL DE BENEFICIÁRIO BPC DO RECIFE - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# ------------------------------------------------------------------------------
# Configurações do AI Studio / Aplicação
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Chave de API para chamadas aos modelos Gemini.
# O AI Studio injeta esta variável automaticamente em tempo de execução via segredos do usuário.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública onde esta aplicação está hospedada.
# O AI Studio injeta esta variável automaticamente em tempo de execução com a URL do Cloud Run.
APP_URL="MY_APP_URL"

# PORT: Porta TCP utilizada pelo servidor Fastify (padrão: 3000)
PORT="3000"

# ------------------------------------------------------------------------------
# Conexão com o Banco de Dados MySQL
# ------------------------------------------------------------------------------
# Host ou endereço IP do servidor MySQL (ex: localhost, 127.0.0.1 ou host do provedor Cloud)
MYSQL_HOST="localhost"

# Porta TCP do serviço MySQL (padrão oficial: 3306)
MYSQL_PORT="3306"

# Nome do usuário com privilégios de leitura e escrita no banco de dados
MYSQL_USER="root"

# Senha de autenticação do usuário MySQL
MYSQL_PASSWORD=""

# Nome do banco de dados (schema) a ser utilizado pela aplicação
MYSQL_DATABASE="bpc_recife_db"

# (Opcional) String de conexão completa em formato URL:
# mysql://<usuario>:<senha>@<host>:<porta>/<banco_de_dados>
# Se informada, esta URL terá precedência sobre as variáveis individuais acima.
MYSQL_URL="mysql://root:@localhost:3306/bpc_recife_db"

# ------------------------------------------------------------------------------
# Autenticação e Segurança (RBAC)
# ------------------------------------------------------------------------------
# Segredo utilizado para assinar e validar tokens JWT nas sessões de usuários
JWT_SECRET="bpc_recife_jwt_secret_key_2026"
